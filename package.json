{
  "name": "kehikot-module-protocol",
  "version": "2.94.0",
  "description": "The shapes a Kehikot host and a module it frames agree on: the manifest, the wire, and the extension payloads. Shapes only — no I/O, no state, no decisions.",
  "keywords": [
    "kehikot",
    "kehikko",
    "module",
    "protocol",
    "manifest",
    "postmessage",
    "iframe",
    "mcp",
    "zod"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./facets": {
      "types": "./dist/facets.d.ts",
      "default": "./dist/facets.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/react": {
      "types": "./dist/client/react.d.ts",
      "default": "./dist/client/react.js"
    },
    "./client/mount": {
      "types": "./dist/client/mount.d.ts",
      "default": "./dist/client/mount.js"
    },
    "./client/find": {
      "types": "./dist/client/find-adapters.d.ts",
      "default": "./dist/client/find-adapters.js"
    },
    "./proposals": {
      "types": "./dist/proposals/index.d.ts",
      "default": "./dist/proposals/index.js"
    },
    "./proposals/store": {
      "types": "./dist/proposals/store.d.ts",
      "default": "./dist/proposals/store.js"
    },
    "./client/proposals": {
      "types": "./dist/client/proposals.d.ts",
      "default": "./dist/client/proposals.js"
    },
    "./client/ui": {
      "types": "./dist/client/ui/index.d.ts",
      "default": "./dist/client/ui/index.js"
    },
    "./client/ui/chart": {
      "types": "./dist/client/ui/chart-index.d.ts",
      "default": "./dist/client/ui/chart-index.js"
    },
    "./serve": {
      "types": "./dist/serve/index.d.ts",
      "default": "./dist/serve/index.js"
    },
    "./run": {
      "types": "./dist/ready/run.d.ts",
      "default": "./dist/ready/run.js"
    },
    "./build": {
      "types": "./dist/ready/build.d.ts",
      "default": "./dist/ready/build.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kehikot-create": "./bin/create.ts",
    "kehikot-check-parts": "./bin/check-parts.ts",
    "kehikot-check-door": "./bin/check-door.ts",
    "kehikot-check-rows": "./bin/check-rows.ts",
    "kehikot-check-notes": "./bin/check-notes.ts"
  },
  "files": [
    "dist",
    "src",
    "template",
    "bin",
    "README.md"
  ],
  "sideEffects": [
    "./dist/client/mailbox.js",
    "./dist/client/errors.js",
    "./dist/client/index.js",
    "./src/client/mailbox.ts",
    "./src/client/errors.ts",
    "./src/client/index.ts",
    "./dist/client/mount.js",
    "./src/client/mount.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && bun test",
    "prepublishOnly": "bun run build",
    "create": "bun run bin/create.ts",
    "check:parts": "bun run bin/check-parts.ts",
    "check:door": "bun run bin/check-door.ts",
    "check:rows": "bun run bin/check-rows.ts",
    "check:notes": "bun run bin/check-notes.ts"
  },
  "peerDependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/headless": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.7.0",
    "zod": "^3.25.76"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@radix-ui/react-collapsible": {
      "optional": true
    },
    "@radix-ui/react-scroll-area": {
      "optional": true
    },
    "@radix-ui/react-separator": {
      "optional": true
    },
    "@radix-ui/react-slot": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  }
}
